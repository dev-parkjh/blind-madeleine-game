          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 300,
          "animation_speed": 1,
          "portrait_opacity": 1,
          "portrait_position": "center"
        }
      }
    },
    {
      "id": "place_a_present_b_update",
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "그 기록이 정말 갱신되어 있었다면 이야기가 달라져요. 숨겨 두었던 대답을 더 들려드릴 수 있겠네요.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "happy",
