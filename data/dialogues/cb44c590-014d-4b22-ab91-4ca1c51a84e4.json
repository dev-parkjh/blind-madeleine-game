        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "[bgm_volume volume=0.5 fade=0.5]요즘 사람들은 대체로 스스로 탐정을 찾지 않아.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "경찰이 있고, 보험사가 있고, 데이터 복원 업체가 있어.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "심지어 사설 영상 분석 회사가 있고, 그런 회사들조차 알음알음 뒷돈을 챙겨가며 AI로 증거 영상까지 조작해 주는 시대라고.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "기술의 발전은 우리에게 무궁한 안락을 가져다줄 것처럼 보였지만, 적어도 나에겐 사실과 거짓을 구별할 수 없는...",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "그런- 정보들이 흘러넘치는 [color=#6aa8ff]디스토피아를 만드는 도구[/color]처럼 느껴졌다.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "어찌 보면 이런 수순은 당연한 것이었을지도 모른다.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "그러니까...... 우리 같은 삼류 공인 탐정 사무소에는 제 발로 걸어 들어오는 평범한 의뢰가 좀처럼 없지.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "지금은 AI가 생성한 가짜 범죄 신고가 범람하는 시대고, 경찰은 실적이 될 만한 사건만 골라 먹는 체리피킹을 시전하니까.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "[wave amp=28.0 freq=5.0 connected=1]그래서~ 선생님께서는 무슨 말씀이 하고 싶으신 걸까요...?[/wave]",
      "stage_cast": {
