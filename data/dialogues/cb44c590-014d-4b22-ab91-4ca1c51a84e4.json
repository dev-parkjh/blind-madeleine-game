          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 300,
          "animation_speed": 1,
          "portrait_opacity": 1,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "여자아이라면 가끔은 [font_size=42]금고 탄 왕자님[/font_size]을 기다릴 때도 있는 법이라고요.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 300,
          "animation_speed": 1,
          "portrait_opacity": 1,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
