          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "왜?",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
