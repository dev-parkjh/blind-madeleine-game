    {
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "[speed=1.8]혹시라도 돈통이......[/speed][auto_next delay=0.35]",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 300,
