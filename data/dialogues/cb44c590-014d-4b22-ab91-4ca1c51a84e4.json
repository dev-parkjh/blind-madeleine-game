        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "아니... 돈이 되는 의뢰를 들고 찾아오는 사람이 있을 수 있으니까요!",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 300,
          "animation_speed": 1,
          "portrait_opacity": 1,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "이... 날씨에......?",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "narrator",
      "text": "[bgm_volume volume=1 fade=0.5]창밖에서는 아직도 퉁명스러운 빗소리가 들려오고 있다.",
