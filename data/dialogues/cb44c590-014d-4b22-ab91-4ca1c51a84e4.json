        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "우린 경찰이 밀어낸 의뢰들을 공문으로 받아, 삶을 영위하는 도시의 청소부라는 것을 자각해야 한다는 이야기야.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "f1b4080b-01b5-4c92-a07c-81649c4595b7",
      "text": "그리고 문제는 이 청소부들께서는 경찰이 어영부영 떠넘긴 예약 목록 없이는 좀처럼 할 일이 없다는거고.",
      "stage_cast": {
        "235db733-cbb2-4c89-86fc-377149f9de48": {
          "portrait": "default",
          "animation_order": 1,
          "portrait_zoom": 250,
          "animation_speed": 1.25,
          "portrait_opacity": 0.7,
          "portrait_position": "center"
        },
        "4144500b-00e2-49c0-a35a-ba6338201609": {
          "portrait": ""
        },
        "f1b4080b-01b5-4c92-a07c-81649c4595b7": {
          "portrait": ""
        }
      }
    },
    {
      "speaker": "235db733-cbb2-4c89-86fc-377149f9de48",
      "text": "선생님은 참 낭만이 없으시다니까요.",
      "stage_cast": {
